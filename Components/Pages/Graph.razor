@page "/"
@page "/graph"
@using System.Net.Http.Json
@using AdefHelpDeskGraphExplorer.Models.Graph
@implements IDisposable
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Graph</PageTitle>

<h1>Help-Desk Graph</h1>

<div class="mb-3 graph-toolbar">
    <button class="btn btn-primary"
            @onclick="Rebuild"
            disabled="@IsBusy">
        @ButtonText
    </button>

    <div style="position: relative;">
        <button class="btn btn-outline-secondary"
                @onclick="ToggleFilterPopup"
                disabled="@(IsBusy || _graph is null)"
                type="button">
            Filter
            @if (FilterCount > 0)
            {
                <span class="badge bg-primary ms-2">@FilterCount</span>
            }
        </button>

        @if (_filterOpen)
        {
            <div class="card shadow"
                 style="position: absolute; top: 100%; left: 0; margin-top: 4px; min-width: 280px; max-height: 70vh; overflow-y: auto; z-index: 30;">
                <div class="card-body">
                    <RadzenStack Gap="1rem">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin:0;">Node Types</RadzenText>
                        @if (_facets.NodeTypes.Count == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="color:#64748b;">No data loaded.</RadzenText>
                        }
                        else
                        {
                            <RadzenCheckBoxList TValue="string"
                                                @bind-Value="_filter.NodeTypesList"
                                                @bind-Value:after="ApplyFilters"
                                                Orientation="Orientation.Vertical">
                                <Items>
                                    @foreach (var t in _facets.NodeTypes)
                                    {
                                        <RadzenCheckBoxListItem Text="@t" Value="@t" />
                                    }
                                </Items>
                            </RadzenCheckBoxList>
                        }

                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin:0;">Users</RadzenText>
                        @if (_facets.Users.Count == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="color:#64748b;">(no users)</RadzenText>
                        }
                        else
                        {
                            <RadzenDropDown TValue="IEnumerable<string>"
                                            Data="@_facets.Users"
                                            TextProperty="Label"
                                            ValueProperty="Id"
                                            @bind-Value="_filter.UsersList"
                                            @bind-Value:after="ApplyFilters"
                                            Multiple="true"
                                            AllowClear="true"
                                            AllowFiltering="true"
                                            Chips="true"
                                            Placeholder="All users"
                                            Style="width: 100%;" />
                            <div class="d-flex gap-2">
                                <RadzenButton Text="Select all" Size="ButtonSize.ExtraSmall"
                                              ButtonStyle="ButtonStyle.Light"
                                              Click="@SelectAllUsers" />
                                <RadzenButton Text="Clear" Size="ButtonSize.ExtraSmall"
                                              ButtonStyle="ButtonStyle.Light"
                                              Click="@ClearUsers" />
                            </div>
                        }

                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin:0;">Requesters</RadzenText>
                        @if (_facets.Requesters.Count == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="color:#64748b;">(no requesters)</RadzenText>
                        }
                        else
                        {
                            <RadzenDropDown TValue="IEnumerable<string>"
                                            Data="@_facets.Requesters"
                                            TextProperty="Label"
                                            ValueProperty="Id"
                                            @bind-Value="_filter.RequestersList"
                                            @bind-Value:after="ApplyFilters"
                                            Multiple="true"
                                            AllowClear="true"
                                            AllowFiltering="true"
                                            Chips="true"
                                            Placeholder="All requesters"
                                            Style="width: 100%;" />
                            <div class="d-flex gap-2">
                                <RadzenButton Text="Select all" Size="ButtonSize.ExtraSmall"
                                              ButtonStyle="ButtonStyle.Light"
                                              Click="@SelectAllRequesters" />
                                <RadzenButton Text="Clear" Size="ButtonSize.ExtraSmall"
                                              ButtonStyle="ButtonStyle.Light"
                                              Click="@ClearRequesters" />
                            </div>
                        }

                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin:0;">Tasks</RadzenText>
                        @if (_facets.Tasks.Count == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="color:#64748b;">(no tasks)</RadzenText>
                        }
                        else
                        {
                            <RadzenDropDown TValue="IEnumerable<string>"
                                            Data="@_facets.Tasks"
                                            TextProperty="Label"
                                            ValueProperty="Id"
                                            @bind-Value="_filter.TasksList"
                                            @bind-Value:after="ApplyFilters"
                                            Multiple="true"
                                            AllowClear="true"
                                            AllowFiltering="true"
                                            Chips="true"
                                            Placeholder="All tasks"
                                            Style="width: 100%;" />
                            <div class="d-flex gap-2">
                                <RadzenButton Text="Select all" Size="ButtonSize.ExtraSmall"
                                              ButtonStyle="ButtonStyle.Light"
                                              Click="@SelectAllTasks" />
                                <RadzenButton Text="Clear" Size="ButtonSize.ExtraSmall"
                                              ButtonStyle="ButtonStyle.Light"
                                              Click="@ClearTasks" />
                            </div>
                        }

                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin:0;">Task Status</RadzenText>
                        @if (_facets.TaskStatuses.Count == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="color:#64748b;">(none)</RadzenText>
                        }
                        else
                        {
                            <RadzenCheckBoxList TValue="string"
                                                @bind-Value="_filter.TaskStatusesList"
                                                @bind-Value:after="ApplyFilters"
                                                Orientation="Orientation.Vertical">
                                <Items>
                                    @foreach (var s in _facets.TaskStatuses)
                                    {
                                        <RadzenCheckBoxListItem Text="@s" Value="@s" />
                                    }
                                </Items>
                            </RadzenCheckBoxList>
                        }

                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin:0;">Detail Type</RadzenText>
                        @if (_facets.DetailTypes.Count == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="color:#64748b;">(none)</RadzenText>
                        }
                        else
                        {
                            <RadzenCheckBoxList TValue="string"
                                                @bind-Value="_filter.DetailTypesList"
                                                @bind-Value:after="ApplyFilters"
                                                Orientation="Orientation.Vertical">
                                <Items>
                                    @foreach (var d in _facets.DetailTypes)
                                    {
                                        <RadzenCheckBoxListItem Text="@d" Value="@d" />
                                    }
                                </Items>
                            </RadzenCheckBoxList>
                        }

                        <div class="d-flex justify-content-between">
                            <RadzenButton Text="Reset"
                                          ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.Small"
                                          Click="ResetFilters" />
                            <RadzenButton Text="Close"
                                          ButtonStyle="ButtonStyle.Secondary"
                                          Variant="Variant.Outlined"
                                          Size="ButtonSize.Small"
                                          Click="@(() => _filterOpen = false)" />
                        </div>
                    </RadzenStack>
                </div>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_status))
    {
        <span class="ms-2">@_status</span>
    }
</div>

<div class="graph-wrap">
    <div id="graph-container" class="@(IsBusy ? "graph-busy" : null)"></div>

    @if (IsBusy)
    {
        <div class="graph-overlay">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate"
                                       ShowValue="false"
                                       Size="ProgressBarCircularSize.Medium" />
            <RadzenText TextStyle="TextStyle.Subtitle1">@StatusText</RadzenText>
        </div>
    }

    <AdefHelpDeskGraphExplorer.Components.Graph.NodePropertiesPanel
        Node="_selectedNode"
        OnClose="ClosePanel"
        OnAsk="NavigateToChat" />
</div>

@code {
    private enum GraphPageState { Idle, Building, Rendering }

    private GraphPageState _state = GraphPageState.Idle;
    private bool IsBusy => _state != GraphPageState.Idle;
    private string _status = "";

    private GraphDocument? _graph;
    private GraphNode? _selectedNode;

    private GraphFacets _facets = GraphFacets.Empty;
    private GraphFilterState _filter = new();
    private bool _filterOpen;

    private DotNetObjectReference<Graph>? _selfRef;

    private string ButtonText => _state switch
    {
        GraphPageState.Building => "Building…",
        GraphPageState.Rendering => "Rendering…",
        _ => "Rebuild graph"
    };

    private string StatusText => _state switch
    {
        GraphPageState.Building => "Building graph…",
        GraphPageState.Rendering => "Loading graph…",
        _ => ""
    };

    private int FilterCount =>
        ((_facets.NodeTypes.Count > 0 && _filter.NodeTypes.Count != _facets.NodeTypes.Count) ? 1 : 0)
        + ((_filter.TaskStatuses.Count > 0 && _filter.TaskStatuses.Count != _facets.TaskStatuses.Count) ? 1 : 0)
        + ((_filter.DetailTypes.Count > 0 && _filter.DetailTypes.Count != _facets.DetailTypes.Count) ? 1 : 0)
        + (_filter.Users.Count > 0 ? 1 : 0)
        + (_filter.Tasks.Count > 0 ? 1 : 0)
        + (_filter.Requesters.Count > 0 ? 1 : 0);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("graphView.init", "graph-container", _selfRef);
            await TryRender();
        }
    }

    private async Task TryRender()
    {
        _state = GraphPageState.Rendering;
        StateHasChanged();

        try
        {
            // Load doc into Blazor so we can populate facets and look up nodes
            // when the user clicks them, then ask JS to render the same data.
            await LoadGraphDocumentAsync();
            await JS.InvokeVoidAsync("graphView.render");
            // JS calls back to OnRenderComplete when stabilization finishes.
        }
        catch (Exception ex)
        {
            _status = $"Render error: {ex.Message}";
            _state = GraphPageState.Idle;
            StateHasChanged();
        }
    }

    private async Task LoadGraphDocumentAsync()
    {
        try
        {
            var http = HttpFactory.CreateClient();
            http.BaseAddress = new Uri(Nav.BaseUri);
            _graph = await http.GetFromJsonAsync<GraphDocument>("api/graph.json");
        }
        catch
        {
            _graph = null;
        }

        _facets = _graph is null ? GraphFacets.Empty : GraphFacets.From(_graph);

        // Default filter: all node types checked; status/detail empty (= show all).
        _filter = new GraphFilterState
        {
            NodeTypesList = _facets.NodeTypes.ToList()
        };
        _selectedNode = null;
    }

    private async Task Rebuild()
    {
        _state = GraphPageState.Building;
        _status = "Building…";
        _filterOpen = false;
        StateHasChanged();

        try
        {
            var http = HttpFactory.CreateClient();
            http.BaseAddress = new Uri(Nav.BaseUri);
            var resp = await http.PostAsync("api/graph/build", content: null);
            var body = await resp.Content.ReadAsStringAsync();
            _status = resp.IsSuccessStatusCode ? $"✔ {body}" : $"✖ {(int)resp.StatusCode}: {body}";
            if (resp.IsSuccessStatusCode)
            {
                await TryRender();
                return;
            }
        }
        catch (Exception ex)
        {
            _status = $"✖ {ex.Message}";
        }

        _state = GraphPageState.Idle;
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnNodeSelected(string id)
    {
        _selectedNode = _graph?.Nodes.FirstOrDefault(n => n.Id == id)
            ?? new GraphNode { Id = id, Type = "Unknown", Label = id };
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnRenderComplete()
    {
        if (_state == GraphPageState.Rendering)
        {
            _state = GraphPageState.Idle;
            return InvokeAsync(StateHasChanged);
        }
        return Task.CompletedTask;
    }

    private async Task ClosePanel()
    {
        _selectedNode = null;
        try { await JS.InvokeVoidAsync("graphView.unselectAll"); } catch { /* ignore */ }
        StateHasChanged();
    }

    private void NavigateToChat(GraphNode node)
    {
        Nav.NavigateTo($"/chat?scope=node:{Uri.EscapeDataString(node.Id)}");
    }

    private void ToggleFilterPopup() => _filterOpen = !_filterOpen;

    private Task SelectAllUsers()
    {
        _filter.UsersList = _facets.Users.Select(u => u.Id).ToList();
        return ApplyFilters();
    }

    private Task ClearUsers()
    {
        _filter.UsersList = Array.Empty<string>();
        return ApplyFilters();
    }

    private Task SelectAllTasks()
    {
        _filter.TasksList = _facets.Tasks.Select(t => t.Id).ToList();
        return ApplyFilters();
    }

    private Task ClearTasks()
    {
        _filter.TasksList = Array.Empty<string>();
        return ApplyFilters();
    }

    private Task SelectAllRequesters()
    {
        _filter.RequestersList = _facets.Requesters.Select(r => r.Id).ToList();
        return ApplyFilters();
    }

    private Task ClearRequesters()
    {
        _filter.RequestersList = Array.Empty<string>();
        return ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        try
        {
            await JS.InvokeVoidAsync("graphView.applyFilters", _filter);
        }
        catch (Exception ex)
        {
            _status = $"Filter error: {ex.Message}";
        }
    }

    private async Task ResetFilters()
    {
        _filter = new GraphFilterState
        {
            NodeTypesList = _facets.NodeTypes.ToList()
        };
        await ApplyFilters();
    }

    public void Dispose()
    {
        _selfRef?.Dispose();
        _selfRef = null;
    }
}
