@using AdefHelpDeskGraphExplorer.Models

<div class="chat-message-list" @ref="_container">
    @{
        var visible = Messages.Where(m => m.Role != ChatTurnRole.System).ToList();
        for (var i = 0; i < visible.Count; i++)
        {
            if (visible[i].Role == ChatTurnRole.Tool)
            {
                var start = i;
                while (i < visible.Count && visible[i].Role == ChatTurnRole.Tool) i++;
                var group = visible.GetRange(start, i - start);
                i--;
                <ToolCallsCard Calls="group" />
            }
            else
            {
                <MessageBubble Message="visible[i]" />
            }
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ChatTurn> Messages { get; set; } = Array.Empty<ChatTurn>();

    private ElementReference _container;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Messages.Count > 0)
        {
            try
            {
                await JS.InvokeVoidAsync("simpleChatScroll.scrollToBottom", _container);
            }
            catch { /* JS module may not be loaded yet */ }
        }
    }

    [Inject] IJSRuntime JS { get; set; } = default!;
}
